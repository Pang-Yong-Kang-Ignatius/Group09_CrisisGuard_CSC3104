CLOUD_PROJECT=crisisguard-aws-cloud
# Replace with the cloud EC2 instance's PRIVATE IPv4 address.
CLOUD_BIND_ADDRESS=REPLACE_CLOUD_PRIVATE_IP
PATIENT_PORT=8001
EMERGENCY_PORT=8003
ADMIN_PORT=8004
POSTGRES_USER=crisisguard
# Generate a new hex password (see README); do not use the local demo password.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_DB=crisisguard
