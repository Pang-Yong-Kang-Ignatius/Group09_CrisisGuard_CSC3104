# Replay policy; Inspector comparison controls do not modify these settings.
SCHEDULER_ENABLE_INHERITANCE=1
SCHEDULER_AGEING_INTERVAL_SECONDS=600

POSTGRES_USER=crisisguard
POSTGRES_PASSWORD=crisisguard_dev
POSTGRES_DB=crisisguard
POSTGRES_PORT=5433

# Local MetaGuard controller. Required by start.project.bat.
CONTROLLER_PORT=8005
# Generate a private value in your .env before using trusted lifecycle APIs.
# The Windows launcher requires three distinct values of at least 32 characters.
CONTROLLER_CLOUD_TOKEN=

# Opt-in grant-based automatic replay: add infrastructure/docker/compose.metaguard.yaml.
# Generate independent private 32+ character tokens; never reuse the operator token.
HOSPITAL_A_CONTROLLER_TOKEN=
HOSPITAL_B_CONTROLLER_TOKEN=

# Grant-based overlay: defaults and tuning are documented in docs/DOCKER.md.
CONTROLLER_ADMISSION_ENABLED=1


# Optional local telemetry authentication. If set, use two distinct private values.
CLOUD_LIVE_TELEMETRY_TOKEN=
CLOUD_REPLAY_TELEMETRY_TOKEN=
